APP_NAME="Escape Room Personeelsavond"
APP_ENV=local
APP_KEY=base64:WnCFRj2RIwYJOg9TufbpE8fBTrn2EZ+/3B5DuJGt9jw=
APP_DEBUG=true
APP_URL=http://escape-room-personeelsavond.test

# mysql (standaard) of sqlite. Bij sqlite is DB_DATABASE het pad naar het bestand.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=escape_room
DB_USERNAME=root
DB_PASSWORD=
DB_CHARSET=utf8mb4
# DB_SOCKET=/var/run/mysqld/mysqld.sock

# phpMyAdmin onder de eigen URL van de app: /phpmyadmin (alleen voor beheerders).
# PHPMYADMIN_MODE=proxy houdt de URL van de app, redirect stuurt door naar PHPMYADMIN_URL.
PHPMYADMIN_URL=http://127.0.0.1:8080
PHPMYADMIN_MODE=proxy

